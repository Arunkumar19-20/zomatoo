# Cravey Backend Production Environment Variables

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/cravey
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Database Migration (Flyway)
FLYWAY_ENABLED=true

# Stripe Production Credentials
# Provide your live keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_actual_stripe_secret_key_here
STRIPE_PUBLIC_KEY=pk_live_your_actual_stripe_public_key_here
# Stripe Webhook Signing Secret from https://dashboard.stripe.com/webhooks
# Point webhook to: https://api.yourdomain.com/payment/webhook
# Events to listen for: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your_actual_webhook_signing_secret_here

# Security & JWT
JWT_SECRET=provide_a_strong_random_secret_with_minimum_256_bits_here
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=900

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Server & App Settings
PORT=8080
ORDER_ABANDONED_TIMEOUT_MINUTES=15
ORDER_CLEANUP_INTERVAL_MS=300000
